{
  "name": "@empowerfi/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:idl": "bash scripts/copy-idl.sh",
    "smoke:solana": "node --env-file=.env --import tsx scripts/solana-smoke.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@hono/node-server": "^1.13.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
