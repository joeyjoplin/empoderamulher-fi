PORT=3001
DATABASE_URL=postgres://user:pass@localhost:5432/empowerfi
AUTH_MODE=mock
AI_SERVICE_URL=http://localhost:8000
LOG_LEVEL=info
CORS_ALLOW_ORIGINS=*
# 32+ random bytes (hex/base64) used as HMAC-SHA256 key to derive on-chain
# Score PDA seeds. Required when calling the score wrapper. Rotation re-derives
# all PDAs — coordinate carefully.
SCORE_HMAC_PEPPER=

# Solana — required for /credit/request to actually disburse on-chain.
# Leave empty to fall back to UnconfiguredLoanService (route returns 502).
# `npm run smoke:solana` (or equivalent) must initialize LoanConfig + PoolState
# on the cluster before the route can succeed.
SOLANA_RPC_URL=
SOLANA_PAYER_SECRET_KEY=
# Devnet/localnet only — generates an ephemeral borrower keypair per loan
# and airdrops it 1 SOL so it can pay rent.
SOLANA_AIRDROP_BORROWER=false
