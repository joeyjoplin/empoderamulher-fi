VITE_BACKEND_URL=http://localhost:3001

# `mock` skips Web3Auth entirely (today's behavior — Landing CTA goes
# straight to /dashboard, persona picker is the only gate). `web3auth`
# turns on the social-login modal and the RequireAuth gate.
VITE_AUTH_MODE=mock

# Required when VITE_AUTH_MODE=web3auth. Get from
# https://dashboard.web3auth.io → create a "Plug & Play" project →
# select Solana → copy the Client ID. Use the Sapphire Devnet network
# while developing; switch to Sapphire Mainnet for production.
VITE_WEB3AUTH_CLIENT_ID=
